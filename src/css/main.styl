html
  height 100vh
  height 100svh
  overflow hidden

body
  margin 0
  padding 0
  min-height 100vh
  min-height 100svh
  overflow hidden
  display flex
  justify-content center
  align-items center
  background-image url("/img/background.png")
  font-family 'Courier New'

@font-face
  font-family: 'modelista';
  src: url('/fonts/modelista-signature.woff2') format('woff2'),
       url('/fonts/modelista-signature.woff') format('woff'),
       url('/fonts/modelista-signature.otf') format('opentype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;

#container
  perspective 1000px

#card
  box-shadow 10px 25px 35px rgba(0, 0, 0, 0.35)
  border-top 2px solid rgba(256, 256, 256, 0.8)
  border-left 1px solid rgba(256, 256, 256, 0.8)
  border-right 1px solid rgba(0, 0, 0, 0.4)
  border-bottom 2px solid rgba(0, 0, 0, 0.4)
  border-radius 4px

  h1
    font-family "modelista", cursive
    font-size 45px
    margin 30px 0px 0px 0px

    // Apply different stylistic sets so letters vary between the 2 words
    .g1, .g2
      display inline-block

    .g1
      font-feature-settings "ss01" 1

    .g2
      font-feature-settings "ss02" 1

  position relative
  &.ready
    transition transform 1s ease-in-out, border-top-color 1s ease-in-out, border-bottom-color 1s ease-in-out
    animation lift 0.8s ease-out
  will-change transform
  transform-style preserve-3d
  background-image url("/img/paper.png")

  p
    margin 0

  h1, p
    opacity 0.7

  &.inverted-light
    border-top-color rgba(0, 0, 0, 0.4)
    border-bottom-color rgba(256, 256, 256, 0.8)

  &.flipping
    animation flip-shadow 1s ease-in-out

  &:focus-visible
    outline 2px solid rgba(0, 0, 0, 0.6)
    outline-offset 4px

#card, #front, #back
  width 315px
  height 180px

#front, #back
  top 0
  left 0
  position absolute

#front
  z-index 2
  text-align  center
  transform rotateX(0deg)
  backface-visibility hidden

  a
    color inherit
    text-decoration none

#back
  margin auto
  transform rotateX(180deg)
  backface-visibility hidden

  a
    position absolute

#vcard
  height 120px
  width 120px

@keyframes lift
  0%
    box-shadow 2px 4px 6px rgba(0, 0, 0, 0.7)
  100%
    box-shadow 10px 25px 35px rgba(0, 0, 0, 0.35)

@keyframes flip-shadow
  0%
    box-shadow 10px 25px 35px rgba(0, 0, 0, 0.35)
  50%
    box-shadow 12px 35px 55px rgba(0, 0, 0, 0.2)
  100%
    box-shadow 10px 25px 35px rgba(0, 0, 0, 0.35)

@media (prefers-reduced-motion: reduce)
  #card.ready
    transition none
    animation none
  #card.flipping
    animation none
